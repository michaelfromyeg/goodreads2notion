# Notion Integration Token
# Get yours at: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_your_token_here

# Notion Database ID
# Copy from your database URL: notion.so/workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=your_database_id_here

# Goodreads User ID (for RSS sync)
# Find in your profile URL: goodreads.com/user/show/USER_ID
GOODREADS_USER_ID=120686315
